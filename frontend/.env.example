# Sanjeevani Frontend Environment Configuration

# Fastify Backend HTTP API URL (without trailing slash)
# In development (when proxied through Vite), this can be left blank or set to http://localhost:3000
# In production (e.g., deployed on Render/Railway), set this to your backend service URL
VITE_API_URL=http://localhost:3000

# Fastify Backend WebSocket URL
# In development, set to ws://localhost:3000 (or leave empty if proxied)
# In production (e.g., deployed on Render/Railway), set this to your backend WebSocket URL (wss://your-backend.onrender.com)
VITE_WS_URL=ws://localhost:3000
